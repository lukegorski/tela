{
  "name": "@tela/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./router": {
      "types": "./dist/trpc/router.d.ts",
      "import": "./dist/trpc/router.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node --import ./dist/instrument.js dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@hono/trpc-server": "^0.3.0",
    "@sentry/node": "^9.27.0",
    "@supabase/supabase-js": "^2.104.0",
    "@tela/capabilities": "workspace:*",
    "@tela/config": "workspace:*",
    "@tela/db": "workspace:*",
    "@tela/events": "workspace:*",
    "@tela/queue": "workspace:*",
    "@tela/types": "workspace:*",
    "@trpc/server": "^11.3.0",
    "hono": "^4.7.0",
    "pg-boss": "^11.1.0",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.0",
    "superjson": "^2.2.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
