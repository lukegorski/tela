{
  "name": "tela",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:unit": "turbo test:unit",
    "clean": "turbo clean",
    "db:generate": "turbo db:generate --filter=@tela/db",
    "db:migrate": "turbo db:migrate --filter=@tela/db",
    "db:push": "turbo db:push --filter=@tela/db",
    "prompts:sync": "turbo prompts:sync --filter=@tela/prompts",
    "dev:admin": "turbo dev --filter=@tela/admin",
    "verify": "pnpm --filter @tela/db build && pnpm --filter @tela/events typecheck && pnpm --filter @tela/ai typecheck && pnpm --filter @tela/capabilities build && pnpm --filter @tela/api typecheck && pnpm --filter @tela/web typecheck && pnpm --filter @tela/admin typecheck && pnpm --filter @tela/web build && pnpm --filter @tela/admin build && bash scripts/check-no-residue.sh",
    "verify:no-residue": "bash scripts/check-no-residue.sh"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "prettier": "^3.5.0",
    "@typescript-eslint/eslint-plugin": "^8.30.0",
    "@typescript-eslint/parser": "^8.30.0",
    "eslint": "^9.25.0"
  }
}
